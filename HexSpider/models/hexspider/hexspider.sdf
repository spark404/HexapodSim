<sdf version="1.10">
    <model name="hexspider" canonical_link="chassis">
        <pose>0 0 0 0 0 0</pose>
        <!-- Servos modelled as Dynamixel XL430 / 2XL430 in position mode at ~11.1 V:
             P-only position loop with output capped at stall torque (p_gain 5 Nm/rad ~ Position P Gain 640,
             cmd_max 1.4 Nm), plus joint damping 0.23 Nm*s/rad = stall torque / no-load speed (1.4 / 5.97)
             so torque falls linearly with speed like a DC motor. friction 0.03 Nm is a gearbox guess. -->
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"></plugin>
        <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
            <joint_name>leg_br_servo_1</joint_name>
            <initial_position>0.0</initial_position>
            <p_gain>5.0</p_gain>
            <i_gain>0</i_gain>
            <d_gain>0</d_gain>
            <cmd_max>1.4</cmd_max>
            <cmd_min>-1.4</cmd_min>
        </plugin>
        <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
            <joint_name>leg_br_servo_2</joint_name>
